{
  "name": "apk-build-release",
  "version": "0.5.8",
  "private": true,
  "description": "安卓项目批量打包工具（变体选择 + 队列）",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @abr/desktop dev",
    "start": "pnpm --filter @abr/desktop preview",
    "preview": "pnpm --filter @abr/desktop preview",
    "build": "pnpm --filter @abr/desktop build",
    "package": "pnpm --filter @abr/desktop package",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
