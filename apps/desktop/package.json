{
  "name": "@abr/desktop",
  "version": "0.6.3",
  "private": true,
  "description": "Electron 桌面端：主进程负责构建调度与 IO，渲染进程只做界面",
  "author": "dhhheee",
  "packageManager": "pnpm@11.8.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/run.mjs electron-vite dev",
    "build": "node scripts/run.mjs electron-vite build",
    "preview": "node scripts/run.mjs electron-vite preview",
    "package": "node scripts/run.mjs electron-vite build && node scripts/run.mjs electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "changelog": "node scripts/sync-changelog.mjs",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.9",
    "lucide-react": "1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
